{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "$HOME/.config/fastfetch/png/*.png",
        "width": 32,
        "height": 16,
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": " : "
    },
    "modules": [
        {
            "type": "custom",
            "format": "  {#cyan}󰊠  コンピューター"
        },
        {
            "type": "custom",
            "format": "{#light_blue}┌───────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "   OS",
            "keyColor": "red",
            "format": "{name} {version} {build-id} {arch}"
        },
        {
            "type": "kernel",
            "key": "   Kernel",
            "keyColor": "red",
            "format": "{release}"
        },
        {
            "type": "packages",
            "key": "  󰏓 Packages",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "  󰍹 Resolution",
            "keyColor": "green",
            "format": "{scaled-width}x{scaled-height}"
        },
        {
            "type": "custom",
            "key": "  󰈩 DE",
            "keyColor": "yellow",
            "format": "Aqua"
        },
        {
            "type": "terminal",
            "key": "   Terminal",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "{#light_blue}└───────────────────────────────┘"
        },
        "break",
        {
            "type": "title",
            "format": "  {#cyan}{#} : {#1;36}{user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "{#light_blue}┌───────────────────────────────┐"
        },
        {
            "type": "cpu",
            "key": "   CPU",
            "keyColor": "light_blue",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "  󰀟 GPU",
            "keyColor": "light_blue",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "  󰘚 MEM",
            "keyColor": "light_magenta",
            "format": "{used} / {total}"
        },
        {
            "type": "custom",
            "format": "{#light_blue}└───────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#90}  {#38;5;16}"
        }
    ]
}
