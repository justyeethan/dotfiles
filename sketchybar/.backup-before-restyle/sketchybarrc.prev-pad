# A simple sketchybar config for aerospace users to get started with
# Not too different from the base starting config!

PLUGIN_DIR="$CONFIG_DIR/plugins"
. "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# Height unchanged (40); the bar itself is transparent and items sit on pills
sketchybar --bar position=top height=40 color=$TRANSPARENT blur_radius=0 margin=10 y_offset=1 padding_left=0 padding_right=0 shadow=off

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="Hack Nerd Font:Bold:13.0"
  icon.color=$WHITE
  label.color=$WHITE
  background.height=30
  background.corner_radius=9
  background.border_width=0
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
  updates=on
)
sketchybar --default "${default[@]}"

##### Apple logo #####
sketchybar --add item apple left \
  --set apple \
    icon="􀣺" \
    icon.font="SF Pro:Black:16.0" \
    icon.color=$GREEN \
    icon.padding_left=15 \
    icon.padding_right=15 \
    label.drawing=off \
    padding_left=0 \
    padding_right=6 \
    background.color=$BLACK \
    background.drawing=on \
    shadow=on \
    click_script="open -a 'System Settings'"

##### Adding aeropsace layouts #####
# Add the aerospace events we specified in aerospace.toml
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_monitor_change

# Invisible spacer so the workspace pill's left edge matches the
# numeral-to-app gap (the right one is added after the loop)
sketchybar --add item space_pad_l left \
  --set space_pad_l width=1 padding_left=0 padding_right=-3 \
    icon.drawing=off label.drawing=off background.drawing=off

for sid in $(aerospace list-workspaces --all); do
  # Get the display/monitor ID for this workspace
  display_id=$(aerospace list-windows --workspace "$sid" \
    --format "%{monitor-appkit-nsscreen-screens-id}" | head -n1)
  display_id=${display_id:-1}

  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
    display="$display_id" \
    drawing=off \
    padding_left=3 \
    padding_right=3 \
    background.corner_radius=5 \
    background.height=20 \
    background.drawing=off \
    icon="$sid" \
    icon.font="Hack Nerd Font:Bold:14.0" \
    icon.padding_left=6 \
    icon.padding_right=2 \
    label.font="sketchybar-app-font:Regular:14.0" \
    label.padding_right=8 \
    label.padding_left=0 \
    label.y_offset=-1 \
    click_script="aerospace workspace $sid" \
    script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

# Load Icons on startup
for mid in $(aerospace list-monitors | cut -c1); do
  for sid in $(aerospace list-workspaces --monitor "$mid" --empty no); do
    apps=$(aerospace list-windows --workspace "$sid" | \
      awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')

    sketchybar --set space.$sid drawing=on

    icon_strip=" "
    if [ -n "$apps" ]; then
      while read -r app; do
        icon_strip+=" $($CONFIG_DIR/plugins/icon_map_fn.sh "$app")"
      done <<< "$apps"
    else
      icon_strip=""
    fi
    sketchybar --set space.$sid label="$icon_strip"
  done
done

sketchybar --add item space_pad_r left \
  --set space_pad_r width=4 padding_left=0 padding_right=0 \
    icon.drawing=off label.drawing=off background.drawing=off

# One pill around all workspaces (hidden ones are skipped automatically)
sketchybar --add bracket spaces '/space\..*/' space_pad_l space_pad_r \
  --set spaces \
    background.color=$BACKGROUND_2 \
    background.border_color=$YELLOW \
    background.border_width=1 \
    background.height=30 \
    background.corner_radius=9 \
    background.drawing=on \
    shadow=on

##### Front app + its menus (click to open) #####
sketchybar --add item front_app left \
  --set front_app \
    script="$PLUGIN_DIR/front_app.sh" \
    icon.font="sketchybar-app-font:Regular:15.0" \
    icon.color=$WHITE \
    icon.padding_left=10 \
    icon.padding_right=6 \
    label.color=$WHITE \
    label.padding_left=0 \
    label.padding_right=10 \
    padding_left=6 \
    background.color=$BACKGROUND_2 \
    background.drawing=on \
    shadow=on \
    popup.align=left \
    popup.height=30 \
    popup.y_offset=4 \
    popup.background.color=$TRANSPARENT \
    popup.background.border_width=0 \
    popup.background.shadow.drawing=off \
  --subscribe front_app front_app_switched aerospace_workspace_change system_woke mouse.clicked mouse.exited.global

# Up to 20 menu pills, filled in when the popup opens
for i in $(seq 0 19); do
  sketchybar --add item menu.$i popup.front_app \
    --set menu.$i \
      drawing=off \
      icon.drawing=off \
      label.color=$WHITE \
      label.padding_left=10 \
      label.padding_right=10 \
      background.color=$BLACK \
      background.corner_radius=8 \
      background.height=26 \
      background.drawing=on \
      shadow=on
done

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other gititems respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

# Right side, right-to-left, all in one pill:
#   [ cpu  battery  volume  wifi  net↑↓  date  (time) ]   time = small yellow chip

sketchybar --add item clock right \
  --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh" \
    icon="" \
    icon.color=$BLACK \
    icon.padding_left=6 \
    label.color=$BLACK \
    label.padding_left=2 \
    label.padding_right=8 \
    padding_left=4 \
    padding_right=6 \
    background.color=$YELLOW \
    background.height=20 \
    background.corner_radius=6 \
    background.drawing=on \
  --add item date right \
  --set date update_freq=60 script="$PLUGIN_DIR/date.sh" \
    icon="" \
    icon.color=$BLUE \
    label.color=$WHITE \
  --add item net.up right \
  --set net.up \
    width=0 \
    y_offset=6 \
    padding_left=0 \
    icon.padding_left=0 \
    icon="" \
    icon.color=$RED \
    icon.font="Hack Nerd Font:Bold:10.0" \
    icon.padding_right=2 \
    label="000KBps" \
    label.color=$RED \
    label.font="Hack Nerd Font:Bold:9.0" \
  --add item net.down right \
  --set net.down \
    y_offset=-6 \
    padding_left=0 \
    icon.padding_left=0 \
    update_freq=2 \
    script="$PLUGIN_DIR/net.sh" \
    icon="" \
    icon.color=$CYAN \
    icon.font="Hack Nerd Font:Bold:10.0" \
    icon.padding_right=2 \
    label="000KBps" \
    label.color=$CYAN \
    label.font="Hack Nerd Font:Bold:9.0" \
  --subscribe net.down system_woke \
  --add item wifi right \
  --set wifi update_freq=5 \
    script="$PLUGIN_DIR/wifi.sh" \
    icon.font="SF Pro:Semibold:14.0" \
    label.drawing=off \
    padding_right=0 \
    icon.padding_right=6 \
    click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
  --subscribe wifi wifi_change system_woke \
  --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
    icon.font="SF Pro:Regular:14.0" \
    icon.color=$GREY \
  --subscribe volume volume_change \
  --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
    icon.font="SF Pro:Regular:17.0" \
    label.padding_left=2 \
  --subscribe battery system_woke power_source_change \
  --add item cpu right \
  --set cpu update_freq=3 script="$PLUGIN_DIR/cpu.sh" \
    padding_left=10 \
    click_script="open -a 'Activity Monitor'" \
  --add bracket status cpu battery volume net.up net.down wifi date clock \
  --set status \
    background.color=$BACKGROUND_2 \
    background.border_color=$BACKGROUND_2 \
    background.border_width=0 \
    background.height=30 \
    background.corner_radius=9 \
    background.drawing=on \
    shadow=on

sketchybar --add item swap e

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
